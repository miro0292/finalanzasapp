# Copia este archivo como .env.local y llena los valores reales.
# NUNCA subas .env.local a GitHub.

# Config del SDK web de Firebase (Project Settings > General > Tus apps > SDK setup and configuration)
NEXT_PUBLIC_FIREBASE_API_KEY=tu-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=tu-proyecto
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=tu-proyecto.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxxxxxx

# Clave de la API de Anthropic (para el asistente de IA). Se usa solo en el servidor.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
